# Public canonical HTTPS origin. Leave unset to use https://www.johnpaulreju.in
# (johnpaulreju.in redirects there). Set it only for a different, verified domain.
NEXT_PUBLIC_SITE_URL=https://www.johnpaulreju.in

# Server-only key from a Gemini Free Tier project. Leave empty for local profile answers.
GEMINI_API_KEY=

# Server-only credentials for the shared Gemini quota. The connected Upstash
# integration supplies this pair. Upstash's UPSTASH_REDIS_REST_URL and
# UPSTASH_REDIS_REST_TOKEN pair also works. Use a separate database for local QA.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Rolling 24-hour site allowance. Each visitor IP separately gets up to 15 calls.
GEMINI_SITE_DAILY_LIMIT=200
# Optional stable secret to preserve visitor quotas when the Redis token rotates.
GEMINI_QUOTA_HMAC_SECRET=
